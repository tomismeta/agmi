[Unit]
Description=agmi local participation health [release=@AGMI_RELEASE_ID@]
After=agmi.service

[Service]
Type=oneshot
ExecStart="%h/.local/share/agmi/releases/@AGMI_RELEASE_ID@/agmi" --config "%h/.config/agmi/config.toml" --json health --managed-exit --stale-seconds 180 --work-seconds 1800 --answer-grace-seconds 900 --min-free-mib 256
SuccessExitStatus=3
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
# A private user namespace prevents this read-only probe from inspecting the
# controller executable in /proc. Keep the controller's private workspace.
StandardOutput=journal
StandardError=journal
